        {
          "id": "B",
          "text": "Only feasible solution"
        },
        {
          "id": "C",
          "text": "Only integer solution"
        },
        {
          "id": "D",
          "text": "Graphical solution"
        }
      ],
      "correctOptionId": "A"
    },
    {
      "id": "or-bank-set-02-q002",
      "text": "Big-M method uses:",
      "options": [
        {
          "id": "A",
          "text": "Large penalty M for artificial variables"
        },
        {
          "id": "B",
          "text": "Small M"
        },
        {
          "id": "C",
          "text": "No penalty"
        },
        {
          "id": "D",
          "text": "Dual variables"
