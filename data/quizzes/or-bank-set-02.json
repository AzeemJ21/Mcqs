{
  "id": "or-bank-set-02",
  "title": "OR MCQs — Quiz 2 (50 questions)",
  "questions": [
    {
      "id": "or-bank-set-02-q001",
      "text": "Simplex method guarantees:",
      "options": [
        {
          "id": "A",
          "text": "Optimal solution in finite steps (if non-degenerate)"
