      "text": "Optimal dual solution gives:",
      "options": [
        {
          "id": "A",
          "text": "Shadow prices for primal constraints"
        },
        {
          "id": "B",
          "text": "Only objective value"
        },
        {
          "id": "C",
          "text": "Primal variables"
        },
        {
          "id": "D",
          "text": "Nothing useful"
        }
      ],
      "correctOptionId": "A"
    },
    {
