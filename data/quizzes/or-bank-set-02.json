      "correctOptionId": "A"
    },
    {
      "id": "or-bank-set-02-q008",
      "text": "Strong Duality Theorem says:",
      "options": [
        {
          "id": "A",
          "text": "Optimal value of primal = optimal value of dual (if both feasible)"
        },
        {
          "id": "B",
          "text": "Primal is always better"
        },
        {
          "id": "C",
          "text": "Dual is always infeasible"
        },
        {
          "id": "D",
          "text": "No relationship"
        }
      ],
      "correctOptionId": "A"
    },
    {
      "id": "or-bank-set-02-q009",
      "text": "Complementary Slackness means:",
      "options": [
        {
          "id": "A",
          "text": "If slack > 0 in primal, corresponding dual variable = 0"
        },
        {
          "id": "B",
          "text": "Both have slack"
        },
        {
          "id": "C",
          "text": "No slack in either"
        },
        {
          "id": "D",
          "text": "Only primal has slack"
        }
      ],
      "correctOptionId": "A"
    },
    {
      "id": "or-bank-set-02-q010",
      "text": "If primal is unbounded, then dual is:",
      "options": [
        {
          "id": "A",
          "text": "Infeasible"
        },
        {
          "id": "B",
          "text": "Also unbounded"
        },
        {
          "id": "C",
          "text": "Optimal"
        },
        {
          "id": "D",
          "text": "Degenerate"
        }
      ],
      "correctOptionId": "A"
    },
    {
      "id": "or-bank-set-02-q011",
      "text": "Dual variable represents:",
      "options": [
        {
          "id": "A",
          "text": "Shadow price"
        },
        {
          "id": "B",
          "text": "Decision variable"
        },
        {
          "id": "C",
          "text": "Slack"
        },
        {
          "id": "D",
          "text": "Artificial variable"
        }
      ],
      "correctOptionId": "A"
    },
    {
      "id": "or-bank-set-02-q012",
      "text": "Writing dual helps when:",
      "options": [
        {
          "id": "A",
          "text": "Number of constraints >> number of variables"
        },
        {
          "id": "B",
          "text": "2 variables"
        },
        {
          "id": "C",
          "text": "Graphical solution needed"
        },
        {
          "id": "D",
          "text": "Integer problem"
        }
      ],
      "correctOptionId": "A"
    },
    {
      "id": "or-bank-set-02-q013",
      "text": "If a primal constraint is = type, corresponding dual variable is:",
      "options": [
        {
          "id": "A",
          "text": "Unrestricted in sign"
        },
        {
          "id": "B",
          "text": "≥ 0"
        },
        {
          "id": "C",
          "text": "≤ 0"
        },
        {
          "id": "D",
          "text": "Must be zero"
        }
      ],
      "correctOptionId": "A"
    },
    {
