        {
          "id": "B",
          "text": "Only maximization"
        },
        {
          "id": "C",
          "text": "Graphical problems"
        },
        {
          "id": "D",
          "text": "2 variables"
        }
      ],
      "correctOptionId": "A"
    },
    {
      "id": "or-bank-set-02-q004",
      "text": "Number of basic variables =",
      "options": [
        {
          "id": "A",
          "text": "Number of constraints"
