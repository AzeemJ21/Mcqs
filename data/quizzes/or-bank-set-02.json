        {
          "id": "B",
          "text": "Number of variables"
        },
        {
          "id": "C",
          "text": "Number of non-basic"
        },
        {
          "id": "D",
          "text": "1"
        }
      ],
      "correctOptionId": "A"
    },
    {
      "id": "or-bank-set-02-q005",
      "text": "In final optimal tableau, shadow prices are:",
      "options": [
        {
          "id": "A",
          "text": "cj–zj values of slack variables"
        },
        {
          "id": "B",
          "text": "RHS values"
        },
        {
          "id": "C",
          "text": "Objective coefficients"
        },
        {
          "id": "D",
          "text": "Pivot elements"
        }
      ],
      "correctOptionId": "A"
    },
    {
      "id": "or-bank-set-02-q006",
      "text": "Dual of a maximization primal is:",
      "options": [
        {
          "id": "A",
          "text": "Minimization problem"
        },
        {
          "id": "B",
          "text": "Another maximization"
        },
        {
          "id": "C",
          "text": "Same as primal"
        },
        {
          "id": "D",
          "text": "Non-linear"
        }
      ],
      "correctOptionId": "A"
    },
    {
      "id": "or-bank-set-02-q007",
      "text": "If primal has m constraints and n variables, dual has:",
      "options": [
        {
          "id": "A",
          "text": "n constraints and m variables"
