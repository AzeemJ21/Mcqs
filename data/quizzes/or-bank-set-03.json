{
  "id": "or-bank-set-03",
  "title": "OR MCQs — Quiz 3 (50 questions)",
  "questions": [
    {
      "id": "or-bank-set-03-q001",
      "text": "A dummy source is added when:",
      "options": [
        {
          "id": "A",
          "text": "Total supply < Total demand"
        },
        {
          "id": "B",
          "text": "Total supply > Total demand"
        },
        {
          "id": "C",
          "text": "Problem is balanced"
        },
        {
          "id": "D",
          "text": "Only one source"
        }
      ],
      "correctOptionId": "A"
    },
    {
      "id": "or-bank-set-03-q002",
      "text": "A dummy destination is added when:",
      "options": [
        {
          "id": "A",
          "text": "Total supply > Total demand"
        },
        {
          "id": "B",
          "text": "Total supply < Total demand"
        },
        {
          "id": "C",
          "text": "Costs are equal"
